---
import '@fontsource-variable/sofia-sans-condensed';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import PageByline from '../components/PageByline.astro';
import StickyBar from '../components/StickyBar.astro';
import { site, menu, getOperator, sports } from '../lib/data';

interface Props {
  title: string;
  description: string;
  path: string;
  brand?: string;
  type?: string;
  crumbs?: { name: string; href: string }[];
  faq?: { q: string; a: string }[];
  noindex?: boolean;
  h1?: string;
  updated?: string;
}
const { title, description, path, brand, type = '', crumbs = [], faq = [], noindex = false, h1, updated } = Astro.props;
const canonical = new URL(path, site.url).href;
const strip = (s: string) => s.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');

const ld: object[] = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, logo: site.url + '/img/site/logo-light.png' },
];
if (crumbs.length) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site.url).href })),
  });
}
if (faq.length) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
  });
}
const inGroup = (g: { href: string; items: { href: string }[] }) => g.href === path || g.items.some((i) => i.href === path);
const showSticky = brand && getOperator(brand) && type !== 'ranking' && type !== 'info';
---
<!doctype html>
<html lang="fr-CI">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(!site.indexable) ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_CI" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site.url + '/img/site/logo-light.png'} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <header class="site-header">
    <div class="wrap site-header__in">
      <a href="/" class="site-logo" aria-label="paris-sportifs.ci, accueil"><img src="/img/site/logo-dark.png" alt="paris-sportifs.ci" width="220" height="58" /></a>
      <nav class="nav-desk" aria-label="Navigation principale">
        <ul class="mm">
          {menu.map((g) => (
            <li class:list={['mm__item', { 'is-current': inGroup(g) }]}>
              <a class="mm__top" href={g.href} aria-haspopup="true">{g.label}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
              <div class:list={['mm__panel', { 'mm__panel--cols': g.items.length > 5 }]}>
                <ul>
                  {g.items.map((i) => <li><a href={i.href} aria-current={i.href === path ? 'page' : undefined}>{i.label}</a></li>)}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </nav>
      <details class="nav-mob">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Navigation mobile">
          {menu.map((g) => (
            <details class="nav-mob__grp" open={inGroup(g)}>
              <summary>{g.label}</summary>
              <ul>{g.items.map((i) => <li><a href={i.href} aria-current={i.href === path ? 'page' : undefined}>{i.label}</a></li>)}</ul>
            </details>
          ))}
        </nav>
      </details>
    </div>
  </header>

  {h1 && (
    <div class="pagehead">
      <div class="wrap"><div class="pagehead__in">
        {crumbs.length > 1 && (
          <nav class="crumbs" aria-label="Fil d'Ariane">
            {crumbs.map((c, i) => i < crumbs.length - 1 ? <><a href={c.href}>{c.name}</a><span aria-hidden="true">›</span></> : <span>{c.name}</span>)}
          </nav>
        )}
        <h1>{h1}</h1>
        <PageByline updated={updated} />
      </div></div>
    </div>
  )}

  <main class="wrap content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__in">
      <div>
        <img src="/img/site/logo-dark.png" alt="paris-sportifs.ci" width="180" height="47" loading="lazy" />
        <p>Comparateur indépendant des sites de paris sportifs accessibles en Côte d'Ivoire.</p>
      </div>
      <div>
        <p class="site-footer__h">Classements</p>
        <a href="/">Meilleurs sites</a><a href="/paris-en-direct/">Paris en direct</a><a href="/bonus-paris-sportif/">Bonus</a><a href="/paris-sportif-gratuit/">Paris gratuits</a><a href="/application-paris-sportif/">Applications</a><a href="/paris-sportif-apk/">APK Android</a><a href="/paris-sportif-orange-money/">Orange Money</a><a href="/paris-sportif-wave/">Wave</a>
      </div>
      <div>
        <p class="site-footer__h">Sports</p>
        {sports.map((s) => <a href={s.href}>{s.label}</a>)}
      </div>
      <div>
        <p class="site-footer__h">Opérateurs</p>
        <a href="/melbet/">Avis Melbet</a><a href="/melbet-apk/">Melbet APK</a><a href="/code-promo-melbet/">Code promo Melbet</a><a href="/melbet-inscription/">Inscription Melbet</a><a href="/1xbet/">Avis 1xBet</a><a href="/1xbet-apk/">1xBet APK</a><a href="/code-promo-1xbet/">Code promo 1xBet</a><a href="/1xbet-inscription/">Inscription 1xBet</a>
      </div>
      <div>
        <p class="site-footer__h">Infos</p>
        <a href="/methodologie/">Méthodologie</a><a href="/jeu-responsable/">Jeu responsable</a><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a><a href="/mentions-legales/">Mentions légales</a>
      </div>
    </div>
  </footer>
  <div class="rg-band"><strong>18+</strong> Les paris comportent des risques : endettement, dépendance. Jouez avec modération. <a href="/jeu-responsable/">Jeu responsable</a></div>
  {showSticky && <StickyBar brand={brand!} type={type} />}

  <script is:inline>
    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-code]'); if (!b) return;
      var c = b.getAttribute('data-code'), done = function () { var t = b.innerHTML; b.textContent = 'Copié !'; setTimeout(function () { b.innerHTML = t; }, 1600); };
      if (navigator.clipboard) navigator.clipboard.writeText(c).then(done, done); else done();
    });
    if (window.innerWidth < 760) document.querySelectorAll('details.toc[open]').forEach(function (d) { d.removeAttribute('open'); });
  </script>
</body>
</html>
