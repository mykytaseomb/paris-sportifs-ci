---
import { fmtRating } from '../lib/data';
interface Props { rating: number; size?: number }
const { rating, size = 15 } = Astro.props;
const pct = Math.max(0, Math.min(100, (rating / 5) * 100));
---
<span class="stars" style={`--s:${size}px`} role="img" aria-label={`Note ${fmtRating(rating)} sur 5`}>
  <span class="stars__fill" style={`width:${pct}%`}></span>
</span>
