---
interface Props { items?: { q: string; a: string }[] }
const { items = [] } = Astro.props;
const linkify = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary>{f.q}</summary>
      <p set:html={linkify(f.a)} />
    </details>
  ))}
</div>
