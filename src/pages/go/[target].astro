---
/** Redirection partenaire de secours (si .htaccess n'est pas pris en compte). */
import { goTargets } from '../../lib/data';
export function getStaticPaths() {
  return goTargets().map((g) => ({ params: { target: g.from.replace(/^\/go\/|\/$/g, '') }, props: { to: g.to } }));
}
const { to } = Astro.props;
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8" /><meta name="robots" content="noindex, nofollow" />
<meta http-equiv="refresh" content={`0; url=${to}`} /><title>Redirection…</title>
<script is:inline define:vars={{ to }}>location.replace(to);</script></head>
<body><p>Redirection vers <a href={to} rel="sponsored nofollow">le site de l'opérateur</a>…</p></body></html>
